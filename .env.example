# Keep all values server-side. Never prefix these names with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: comma-separated subset/order of the six MVP comparison models.
OPENAI_MODELS=gpt-3.5-turbo,gpt-4o-mini,gpt-4.1,gpt-4o,gpt-5.6-luna,gpt-5.6-sol

# OpenRouter provider for the two public free comparison models.
OPENROUTER_API_KEY=

# Stage Mode and calibration GigaChat credentials. Prefer the ready Base64 key from the API cabinet.
GIGACHAT_AUTHORIZATION_KEY=
# Backward-compatible fallback when GIGACHAT_AUTHORIZATION_KEY is not set.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Optional: comma-separated Stage Mode model list. Keep the manually verified model first.
GIGACHAT_MODELS=GigaChat-2
